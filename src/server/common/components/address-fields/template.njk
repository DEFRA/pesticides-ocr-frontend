{#
  The fields of a typed-in address: two address lines, town, postcode and the
  region radios (shown to users as "Country").

  params:
    values       - the address being shown (addressLine1 ... addressRegion)
    errors       - the page's errors, keyed by field name
    regionItems  - the region radio items (regionItems in common/constants/regions.js)
    fieldClasses - optional width classes for addressLine1, addressLine2,
                   addressTown and addressPostcode
-#}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% set values = params.values %}
{% set errors = params.errors %}
{% set fieldClasses = params.fieldClasses or {} -%}

      {{ govukInput({
        label: {
          text: "Address line 1"
        },
        id: "addressLine1",
        name: "addressLine1",
        value: values["addressLine1"] if values,
        errorMessage: errors["addressLine1"] if errors["addressLine1"],
        autocomplete: "address-line1",
        classes: fieldClasses.addressLine1 or "govuk-!-width-two-thirds"
      }) }}

      {{ govukInput({
        label: {
          text: "Address line 2 (optional)"
        },
        id: "addressLine2",
        name: "addressLine2",
        value: values["addressLine2"] if values,
        errorMessage: errors["addressLine2"] if errors["addressLine2"],
        autocomplete: "address-line2",
        classes: fieldClasses.addressLine2 or "govuk-!-width-two-thirds"
      }) }}

      {{ govukInput({
        label: {
          text: "Town or city"
        },
        id: "addressTown",
        name: "addressTown",
        value: values["addressTown"] if values,
        errorMessage: errors["addressTown"] if errors["addressTown"],
        autocomplete: "address-level2",
        classes: fieldClasses.addressTown or "govuk-!-width-one-third"
      }) }}

      {{ govukInput({
        label: {
          text: "Postcode"
        },
        id: "addressPostcode",
        name: "addressPostcode",
        value: values["addressPostcode"] if values,
        errorMessage: errors["addressPostcode"] if errors["addressPostcode"],
        autocomplete: "postal-code",
        classes: fieldClasses.addressPostcode or "govuk-input--width-10"
      }) }}

      {{ govukRadios({
        idPrefix: "addressRegion",
        name: "addressRegion",
        fieldset: {
          legend: {
            text: "Country",
            classes: "govuk-fieldset__legend--s"
          }
        },
        items: params.regionItems,
        value: values["addressRegion"] if values,
        errorMessage: errors["addressRegion"] if errors["addressRegion"]
      }) -}}
