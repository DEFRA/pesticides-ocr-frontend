{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    {% if errorList %}{{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}{% endif %}

    <form method="get" action="/search" novalidate>
      {{ govukInput({
        label: {
          text: "Search the register",
          classes: "govuk-label--l",
          isPageHeading: true
        },
        hint: { text: "Search for a reference, such as " + exampleReference + ", or a business name, contact, town or postcode" },
        id: "search",
        name: "search",
        value: search,
        classes: "govuk-input--width-30",
        spellcheck: false,
        autocomplete: "off",
        errorMessage: errors["search"] if errors and errors["search"]
      }) }}

      {{ govukButton({ text: "Search" }) }}
    </form>

    {% if operators and operators.length == 0 %}
    <p class="govuk-body">No results found</p>
    {% endif %}

    {% if operators.length %}
    <h2 class="govuk-heading-m">{{ operators.length }} result{{ "s" if operators.length != 1 }}</h2>

    {% for operator in operators %}
    {% set addressHtml %}
    {%- for line in [operator.address.line1, operator.address.town, operator.address.postcode, operator.address.country] | select -%}
    {{ line }}{% if not loop.last %}<br>{% endif %}
    {%- endfor -%}
    {% endset %}
    {% set contactHtml %}
    {%- for line in [operator.contact.name, operator.contact.email, operator.contact.telephone] | select -%}
    {{ line }}{% if not loop.last %}<br>{% endif %}
    {%- endfor -%}
    {% endset %}

    {{ govukSummaryList({
        card: {
          title: { text: operator.businessName or operator.reference },
          actions: {
            items: [
              {
                href: "/search/export?reference=" + (operator.reference | urlencode),
                text: "Export",
                visuallyHiddenText: operator.reference
              }
            ]
          }
        },
        rows: [
          { key: { text: "Reference" }, value: { text: operator.reference } },
          { key: { text: "Status" }, value: { text: operator.status } },
          { key: { text: "Registered" }, value: { text: operator.registeredDate | formatDate("d MMMM yyyy") if operator.registeredDate } },
          { key: { text: "Business activities" }, value: { text: operator.activities | join(", ") } },
          { key: { text: "Main customer" }, value: { text: operator.mainCustomer } },
          { key: { text: "Address" }, value: { html: addressHtml } },
          { key: { text: "Contact" }, value: { html: contactHtml } },
          { key: { text: "Address activities" }, value: { text: operator.addressActivities | join(", ") } },
          { key: { text: "Quantity" }, value: { text: operator.quantity } }
        ]
      }) }}
    {% endfor %}
    {% endif %}

  </div>
</div>
{% endblock %}
