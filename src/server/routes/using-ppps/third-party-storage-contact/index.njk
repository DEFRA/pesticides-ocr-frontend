{% extends 'layouts/page.njk' %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    {% if errorList %}{{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}{% endif %}

    <h1 class="govuk-heading-l">Who stores PPPs on your behalf?</h1>

    <p class="govuk-body">We may need to contact someone about your organisation's PPP storage. This should be a person with knowledge of these activities.</p>

    <form method="post" action="{{ formAction }}" novalidate>

      {{ govukInput({
        label: {
          text: "Contact name"
        },
        id: "contactName",
        name: "contactName",
        value: values["contactName"] if values,
        autocomplete: "name",
        classes: "govuk-!-width-two-thirds",
        errorMessage: errors["contactName"] if errors["contactName"]
      }) }}

      {{ govukInput({
        label: {
          text: "Business name"
        },
        id: "businessName",
        name: "businessName",
        value: values["businessName"] if values,
        autocomplete: "organization",
        classes: "govuk-!-width-two-thirds",
        errorMessage: errors["businessName"] if errors["businessName"]
      }) }}

      {{ govukInput({
        label: {
          text: "Job title or role (optional)"
        },
        id: "contactJobTitle",
        name: "contactJobTitle",
        value: values["contactJobTitle"] if values,
        autocomplete: "organization-title",
        classes: "govuk-!-width-two-thirds",
        errorMessage: errors["contactJobTitle"] if errors["contactJobTitle"]
      }) }}

      {{ govukInput({
        label: {
          text: "Telephone number"
        },
        id: "contactTelephone",
        name: "contactTelephone",
        value: values["contactTelephone"] if values,
        autocomplete: "tel",
        classes: "govuk-!-width-two-thirds",
        errorMessage: errors["contactTelephone"] if errors["contactTelephone"]
      }) }}

      {{ govukInput({
        label: {
          text: "Email address"
        },
        id: "contactEmail",
        name: "contactEmail",
        value: values["contactEmail"] if values,
        autocomplete: "email",
        classes: "govuk-!-width-two-thirds",
        errorMessage: errors["contactEmail"] if errors["contactEmail"]
      }) }}

      {{ govukButton({
        text: "Continue",
        type: "submit"
      }) }}

    </form>
  </div>
</div>
{% endblock %}
