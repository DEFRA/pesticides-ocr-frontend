{% extends 'layouts/page.njk' %}

{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    {% if errorList %}{{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}{% endif %}

    <form method="post" action="{{ formAction }}" novalidate>

      {{ govukCheckboxes({
        name: "storageLocation",
        values: values["storageLocation"] | asList if values,
        fieldset: {
          legend: {
            text: "Which of your sites store PPPs?",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--l"
          }
        },
        hint: {
          text: "Select all that apply",
          classes: "govuk-!-margin-bottom-6"
        },
        errorMessage: errors["storageLocation"] if errors["storageLocation"],
        items: items
      }) }}

      {{ govukButton({
        text: "Continue",
        type: "submit"
      }) }}

    </form>

  </div>
</div>
{% endblock %}
