{% extends 'layouts/page.njk' %}

{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    {% if errorList %}{{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}{% endif %}

    <form method="post" action="{{ formAction }}" novalidate>

      {# A single value is posted as a string, which the macro's "in" check would match as a substring. #}
      {{ govukCheckboxes({
        name: "memberSchemes",
        values: ([values["memberSchemes"]] if values["memberSchemes"] is string else values["memberSchemes"]) if values,
        fieldset: {
          legend: {
            text: "Are you a member of any assurance schemes? (optional)",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--l govuk-!-margin-bottom-6"
          }
        },
        hint: {
          text: "Select all that apply.",
          classes: "govuk-!-margin-bottom-6"
        },
        errorMessage: errors["memberSchemes"] if errors["memberSchemes"],
        items: items
      }) }}

      <h4 class="govuk-heading-s govuk-!-margin-top-6">or</h4>

      {{ govukTextarea({
        name: "memberSchemesOther",
        value: values["memberSchemesOther"] if values,
        id: "memberSchemesOther",
        label: {
          text: "Other",
          classes: "govuk-!-margin-bottom-3"
        },
        hint: {
          text: "Enter the names of any assurance schemes not listed."
        },
        errorMessage: errors["memberSchemesOther"] if errors["memberSchemesOther"]
      }) }}

      {{ govukButton({
        text: "Continue",
        type: "submit"
      }) }}

    </form>

  </div>
</div>
{% endblock %}