{% extends 'layouts/page.njk' %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-xl">OCR Register dashboard</h1>

    {% if account %}
      <p class="govuk-body">
        You are signed in as <strong>{{ account.name }}</strong>{% if account.roleLabel %} ({{ account.roleLabel }}){% endif %}.
      </p>
    {% endif %}

    <p class="govuk-body">This is a protected case-officer area for the OCR register.</p>

    <ul class="govuk-list">
      <li>
        <a class="govuk-link" href="/search">Search the register</a>
        — find a registered operator by reference.
      </li>
      <li>
        <a class="govuk-link" href="/dashboard/metrics">Service metrics</a>
        — journeys started and finished, and the completion rate.
      </li>
    </ul>

  </div>
</div>
{% endblock %}
