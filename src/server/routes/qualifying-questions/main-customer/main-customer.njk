{% extends 'layouts/page.njk' %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set backLink = "/business-activities" %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    {% if errorList %}{{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}{% endif %}

    <form method="post" action="/main-customer" novalidate>

      {{ govukRadios({
        name: "main-customer",
        fieldset: {
          legend: {
            text: "Is your main customer a professional user or amateur user?",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--l govuk-!-margin-bottom-6"
          }
        },
        errorMessage: errors["main-customer"] if errors["main-customer"],
        items: [
          {
            value: "professional",
            text: "Professional user"
          },
          {
            value: "amateur",
            text: "Amateur user"
          },
          {
            value: "both",
            text: "Both professional and amateur users"
          }
        ]
      }) }}

      {{ govukButton({
        text: "Continue",
        type: "submit"
      }) }}

    </form>
  </div>
</div>


{% endblock %}