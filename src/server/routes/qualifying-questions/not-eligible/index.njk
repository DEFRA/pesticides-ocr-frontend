{% extends 'layouts/page.njk' %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    <h1 class="govuk-heading-xl">You do not need to register</h1>

    <p class="govuk-body">This service is for organisations and people carrying out professional PPP activities.</p>

    <p class="govuk-body">You do not need to register if you only use products such as weedkillers, slug pellets or garden sprays in your own home or garden.</p>

    <p class="govuk-body">You do not need to register if you are a member of the public using domestic weedkillers, slug pellets or garden sprays in your own home or garden.</p>

    <h2 class="govuk-heading-m">More information</h2>
    <ul class="govuk-list govuk-list--bullet">
      <li><a class="govuk-link" href="#">Guidance on using pesticides safely in your home and garden</a></li>
      <li><a class="govuk-link" href="#">Search the database of authorised amateur garden products</a></li>
    </ul>

  </div>
</div>

{% endblock %}