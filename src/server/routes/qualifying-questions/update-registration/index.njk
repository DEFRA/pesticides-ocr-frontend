{% extends 'layouts/page.njk' %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    <h1 class="govuk-heading-xl">Update an existing registration</h1>

    <p class="govuk-body">This service does not yet support updating an existing registration online.</p>

    <p class="govuk-body">Please contact the helpline for help with updating your details:</p>
    <ul class="govuk-list govuk-list--bullet">
      <li>email: <a class="govuk-link" href="mailto:defra.helpline@defra.gov.uk?subject=OCR-PPP%20update%20enquiry">defra.helpline@defra.gov.uk</a> (use the subject line ‘OCR-PPP update enquiry’)</li>
      <li>call the helpline: 03459 33 55 77</li>
    </ul>

  </div>
</div>

{% endblock %}
