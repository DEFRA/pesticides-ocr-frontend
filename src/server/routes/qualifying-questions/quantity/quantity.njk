{% extends 'layouts/page.njk' %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set backLink = "/address-activity" %}

{% block content %}
<div class="govuk-grid-row">

  <div class="govuk-grid-column-full">
    {% if errorList %}{{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}{% endif %}

    <form method="post" action="/quantity" novalidate>

      {% set amountHtml %}
      {{ govukInput({
          label: {
            text: "Estimated annual quantity"
          },
          suffix: {
            text: "Litres or kilograms"
          },
          classes: "govuk-input--width-10",
          id: "quantityAmount",
          name: "quantityAmount",
          value: values["quantityAmount"] if values,
          errorMessage: errors["quantityAmount"] if errors["quantityAmount"],
          spellcheck: false,
          inputmode: "decimal"
        }) }}
      {% endset %}

      {% set areaHtml %}
      {{ govukInput({
          label: {
            text: "Estimated annual area covered"
          },
          suffix: {
            text: "Hectares"
          },
          classes: "govuk-input--width-10",
          id: "quantityArea",
          name: "quantityArea",
          value: values["quantityArea"] if values,
          errorMessage: errors["quantityArea"] if errors["quantityArea"],
          spellcheck: false,
          inputmode: "decimal"
        }) }}
      {% endset %}

      {{ govukRadios({
        name: "quantityType",
        fieldset: {
          legend: {
            text: "What quantity of plant protection products (PPPs) or adjuvants do you use at this address in a typical year?",
            isPageHeading: true,
            classes: "govuk-fieldset__legend--l"
          }
        },
        hint: {
          text: "Give an estimate of the total amount of undiluted product you use. You can enter this as the amount in litres or kilograms, or by the area covered."
        },
        errorMessage: errors["quantityType"] if errors["quantityType"],
        items: [
          {
            value: "amount",
            text: "Amount in litres or kilograms",
            checked: values["quantityType"] == "amount" if values,
            conditional: {
              html: amountHtml
            }
          },
          {
            value: "area",
            text: "Area covered in hectares",
            suffix: {
              text: "Hectares"
            },
            checked: values["quantityType"] == "area" if values,
            conditional: {
              html: areaHtml
            }
          }
        ]
      }) }}

      {{ govukButton({
        text: "Continue",
        type: "submit"
      }) }}

    </form>
  </div>
</div>
{% endblock %}