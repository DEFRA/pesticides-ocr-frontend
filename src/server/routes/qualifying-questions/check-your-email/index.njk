{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if errorList %}{{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}{% endif %}

    {% if resent %}
      {{ govukNotificationBanner({
        type: "success",
        text: "We have sent another email to " ~ email
      }) }}
    {% endif %}

    <h1 class="govuk-heading-l">Check your email</h1>

    <p class="govuk-body">We have sent an email to <strong>{{ email }}</strong>.</p>

    <p class="govuk-body">Select the link in the email to confirm your email address.</p>

    {% if linkExpired %}
      <p class="govuk-body">The link has expired. Request another email to get a new link.</p>
    {% else %}
      <p class="govuk-body">The link will expire in {{ expiryMinutes }} minute{{ "s" if expiryMinutes != 1 }}.</p>
    {% endif %}

    <p class="govuk-body">
      <a class="govuk-link" href="{{ changeHref }}">Change email address</a>
    </p>

    {% set resendHtml %}
      <p class="govuk-body">Emails sometimes take a few minutes to arrive. If you do not receive an email soon, check your spam or junk folder.</p>
      <p class="govuk-body">If you still have not received it, you can request another email. Only the link in the most recent email will work.</p>
      <form method="post" action="{{ resendAction }}" novalidate>
        {{ govukButton({
          text: "Request another email",
          classes: "govuk-button--secondary",
          id: "resend"
        }) }}
      </form>
    {% endset %}

    {{ govukDetails({
      summaryText: "Not received an email?",
      html: resendHtml,
      open: linkExpired
    }) }}

    <p class="govuk-body">If you open the link on a different device, come back to this page and select Continue.</p>

    <form method="post" action="{{ continueAction }}" novalidate>
      {{ govukButton({
        text: "Continue"
      }) }}
    </form>

  </div>
</div>
{% endblock %}
