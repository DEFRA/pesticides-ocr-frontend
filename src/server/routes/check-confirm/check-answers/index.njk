{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "answer-list/macro.njk" import appAnswerList %}

{% block content %}
<div class="govuk-grid-row">

  <div class="govuk-grid-column-full">
    {% if errorList %}{{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}{% endif %}

    <h1 class="govuk-heading-l">Check your details</h1>

    <h2 class="govuk-heading-m">Business details</h2>
      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Business PPP activities" },
            value: { html: appAnswerList({ values: answers.businessActivities }) },
            actions: { items: [{ href: "/business-activities?change=true", text: "Change", visuallyHiddenText: "business PPP activities" }] }
          } if answers.businessActivities,
          {
            key: { text: "Business name" },
            value: { html: appAnswerList({ values: answers.businessName }) },
            actions: { items: [{ href: "/business-name?change=true", text: "Change", visuallyHiddenText: "business name" }] }
          } if answers.businessName,
          {
            key: { text: "Main address" },
            value: { html: appAnswerList({ values: answers.address }) },
            actions: { items: [{ href: "/business-address?change=true", text: "Change", visuallyHiddenText: "main address" }] }
          } if answers.address,
          {
            key: { text: "Name" },
            value: { html: appAnswerList({ values: answers.contactName }) },
            actions: { items: [{ href: "/business-contact?change=true", text: "Change", visuallyHiddenText: "name" }] }
          } if answers.contactName,
          {
            key: { text: "Job title or role" },
            value: { html: appAnswerList({ values: answers.contactJobTitle }) },
            actions: { items: [{ href: "/business-contact?change=true", text: "Change", visuallyHiddenText: "job title or role" }] }
          } if answers.contactJobTitle,
          {
            key: { text: "Email" },
            value: { html: appAnswerList({ values: answers.contactEmail }) },
            actions: { items: [{ href: "/business-contact?change=true", text: "Change", visuallyHiddenText: "email" }] }
          } if answers.contactEmail,
          {
            key: { text: "Telephone" },
            value: { html: appAnswerList({ values: answers.contactTelephone }) },
            actions: { items: [{ href: "/business-contact?change=true", text: "Change", visuallyHiddenText: "telephone" }] }
          } if answers.contactTelephone
        ]
      }) }}

      <h2 class="govuk-heading-m">PPP activity details</h2>
      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Who applies PPPs" },
            value: { html: appAnswerList({ values: answers.whoApplies }) },
            actions: { items: [{ href: "/using-ppps/who-applies?change=true", text: "Change", visuallyHiddenText: "who applies PPPs" }] }
          } if answers.whoApplies,
          {
            key: { text: "Contractor name" },
            value: { html: appAnswerList({ values: answers.contractorName }) },
            actions: { items: [{ href: "/using-ppps/contractor-address?change=true", text: "Change", visuallyHiddenText: "contractor name" }] }
          } if answers.contractorName,
          {
            key: { text: "Contractor address" },
            value: { html: appAnswerList({ values: answers.contractorAddress }) },
            actions: { items: [{ href: "/using-ppps/contractor-address?change=true", text: "Change", visuallyHiddenText: "contractor address" }] }
          } if answers.contractorAddress,
          {
            key: { text: "Sectors" },
            value: { html: appAnswerList({ values: answers.professionalSectors }) },
            actions: { items: [{ href: "/using-ppps/ppp-sectors?change=true", text: "Change", visuallyHiddenText: "sectors" }] }
          } if answers.professionalSectors,
          {
            key: { text: "Agricultural sectors" },
            value: { html: appAnswerList({ values: answers.agriSubsectors }) },
            actions: { items: [{ href: "/using-ppps/agri-subsectors?change=true", text: "Change", visuallyHiddenText: "agricultural sectors" }] }
          } if answers.agriSubsectors,
          {
            key: { text: "Amenity sectors" },
            value: { html: appAnswerList({ values: answers.amenitySubsectors }) },
            actions: { items: [{ href: "/using-ppps/amenity-subsector?change=true", text: "Change", visuallyHiddenText: "amenity sectors" }] }
          } if answers.amenitySubsectors,
          {
            key: { text: "Horticultural sectors" },
            value: { html: appAnswerList({ values: answers.hortiSubsectors }) },
            actions: { items: [{ href: "/using-ppps/horti-subsector?change=true", text: "Change", visuallyHiddenText: "horticultural sectors" }] }
          } if answers.hortiSubsectors,
          {
            key: { text: "Storing products" },
            value: { html: appAnswerList({ values: answers.storing }) },
            actions: { items: [{ href: "/using-ppps/storing?change=true", text: "Change", visuallyHiddenText: "storing products" }] }
          } if answers.storing,
          {
            key: { text: "Where products are stored" },
            value: { html: appAnswerList({ values: answers.storageLocation }) },
            actions: { items: [{ href: "/using-ppps/storage-location?change=true", text: "Change", visuallyHiddenText: "where products are stored" }] }
          } if answers.storageLocation,
          {
            key: { text: "Quantity used in a typical year" },
            value: { html: appAnswerList({ values: answers.usingQuantity }) },
            actions: { items: [{ href: "/using-ppps/quantity?change=true", text: "Change", visuallyHiddenText: "quantity used in a typical year" }] }
          } if answers.usingQuantity,
          {
            key: { text: "PPP activities at the address" },
            value: { html: appAnswerList({ values: answers.addressActivities }) },
            actions: { items: [{ href: "/address-activity?change=true", text: "Change", visuallyHiddenText: "PPP activities at the address" }] }
          } if answers.addressActivities,
          {
            key: { text: "Assurance schemes" },
            value: { html: appAnswerList({ values: answers.memberSchemes }) },
            actions: { items: [{ href: "/member-schemes?change=true", text: "Change", visuallyHiddenText: "assurance schemes" }] }
          } if answers.memberSchemes,
          {
            key: { text: "Additional addresses" },
            value: { text: answers.additionalAddresses.length }
          } if answers.additionalAddresses
        ]
      }) }}

      {% if answers.additionalAddresses or canAddAdditionalAddresses %}
        <h2 class="govuk-heading-m">Additional addresses</h2>

        {% for entry in answers.additionalAddresses %}
          {{ govukSummaryList({
            card: {
              title: { text: "Additional address " ~ loop.index }
            },
            rows: [
              { 
                key: { text: "Address" },
                value: { html: appAnswerList({ values: entry.address }) }
              } if entry.address,
              { 
                key: { text: "Name" },
                value: { html: appAnswerList({ values: entry.contactName }) }
              } if entry.contactName,
              { 
                key: { text: "Email" },
                value: { html: appAnswerList({ values: entry.contactEmail }) }
              } if entry.contactEmail,
              { 
                key: { text: "Telephone" },
                value: { html: appAnswerList({ values: entry.contactTelephone }) }
              } if entry.contactTelephone,
              { 
                key: { text: "PPP activity" },
                value: { html: appAnswerList({ values: entry.activity }) }
              } if entry.activity
            ]
          }) }}

          <form method="post" action="/check-answers/additional-addresses/{{ loop.index }}/delete" novalidate>
            {{ govukButton({
              html: "Delete<span class=\"govuk-visually-hidden\"> (Additional address " ~ loop.index ~ ")</span>",
              classes: "govuk-button--secondary"
            }) }}
          </form>
        {% endfor %}

        <p class="govuk-body">
          <a class="govuk-link" href="/additional-addresses/address">Add another address</a>
        </p>
      {% endif %}

      <form method="post" action="/check-answers" novalidate>
        {{ govukButton({
          text: "Save and continue",
          type: "submit"
        }) }}
      </form>
  </div>
</div>
{% endblock %}