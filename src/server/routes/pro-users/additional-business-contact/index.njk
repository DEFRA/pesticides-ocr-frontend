{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set title = "Contact Details" %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    {% if errorList %}{{ govukErrorSummary({ titleText: "There is a problem", errorList: errorList }) }}{% endif %}

    <h1 class="govuk-heading-l">Contact Details</h1>

    <p class="govuk-body">This should be the contact details of someone with a good knowledge of your professional PPP activity.</p>

    <form method="post" action="{{ formAction }}" novalidate>

      {% call govukFieldset({
      }) %}

      {{ govukInput({
        label: {
          text: "Name"
        },
        id: "contactName",
        name: "contactName",
        value: values["contactName"] if values,
        autocomplete: "name",
        classes: "govuk-!-width-two-thirds",
        errorMessage: errors["contactName"] if errors["contactName"]
      }) }}

      {{ govukInput({
        label: {
          text: "Telephone number"
        },
        id: "contactTelephone",
        name: "contactTelephone",
        value: values["contactTelephone"] if values,
        autocomplete: "tel",
        classes: "govuk-!-width-two-thirds",
        errorMessage: errors["contactTelephone"] if errors["contactTelephone"]
      }) }}

      {{ govukInput({
        label: {
          text: "Email address"
        },
        classes: "govuk-!-width-two-thirds",
        id: "contactEmail",
        name: "contactEmail",
        value: values["contactEmail"] if values,
        autocomplete: "email",
        classes: "govuk-!-width-two-thirds",
        errorMessage: errors["contactEmail"] if errors["contactEmail"]
      }) }}

      {% endcall %}

      {{ govukButton({
        text: "Continue",
        type: "submit"
      }) }}

    </form>

    {% endblock %}